# ============================================================
# LARRYBASH 2027 BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Supabase / PostgreSQL) ---
# Project URL and the SERVICE ROLE key (server-side only — bypasses RLS).
# Leave both blank to run in DEV mode with a volatile in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave blank if the frontend is served by this same server (same-origin).
ALLOWED_ORIGINS=

# --- Admin Dashboard (HTTP Basic Auth) ---
# The dashboard is DISABLED until both values are set.
ADMIN_USERNAME=campaign_manager
ADMIN_PASSWORD=change-this-to-a-long-random-password

# --- Welcome message dispatch (optional) ---
# NOTIFY_PROVIDER: "none" | "twilio" | "meta"
NOTIFY_PROVIDER=none

# Twilio (if NOTIFY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (if NOTIFY_PROVIDER=meta)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=

# --- ContactZero Console bridge (Campaign Line Contact Center) ---
# Leave CONTACTZERO_ENABLED unset/false to store leads locally WITHOUT syncing.
# See server/CONTACTZERO_INTEGRATION.md for the contract to obtain from the
# ContactZero API owner (tenant id, service-account creds, confirmed paths/schema).
CONTACTZERO_ENABLED=false
CONTACTZERO_BASE_URL=https://contact.192-248-146-231.nip.io
CONTACTZERO_TENANT_ID=
# Auth: "login" (service account email/password[/totp]) or "bearer" (static token)
CONTACTZERO_AUTH_MODE=login
CONTACTZERO_BEARER_TOKEN=
CONTACTZERO_LOGIN_PATH=/api/v1/auth/login
CONTACTZERO_EMAIL=
CONTACTZERO_PASSWORD=
CONTACTZERO_TOTP=
# CONFIRM this path + payload schema against the ContactZero API contract:
CONTACTZERO_CONTACTS_PATH=/api/v1/contacts
